#!/bin/bash
# =============================================================
#  CinePRO — Preinstall macOS
#  Avisa se o Premiere estiver aberto + remove instalação antiga
# =============================================================

set -e

. "$(dirname "$0")/cinepro-lib.sh"

# 1. Premiere aberto: pede para fechar, com "Tentar de novo" em laço até
#    fechar. "Cancelar" (ou alerta impossível de mostrar) cancela a instalação.
if ! cinepro_esperar_premiere_fechar; then
  exit 1
fi

# 2. Remove instalação antiga (system-wide e per-user)
rm -rf "/Library/Application Support/Adobe/CEP/extensions/CinePRO" 2>/dev/null || true

USER_NAME="${USER:-$(stat -f%Su /dev/console)}"
USER_HOME=$(eval echo "~$USER_NAME")
rm -rf "$USER_HOME/Library/Application Support/Adobe/CEP/extensions/CinePRO" 2>/dev/null || true

# 3. Remove o APP antigo. Sem isso, o Installer PULA a substituição quando o
#    app instalado declara versão "maior" que o payload (proteção de downgrade
#    de bundle) — foi o que travou o re-baseline 1.6.x -> 1.0.
osascript -e 'quit app "CinePRO"' 2>/dev/null || true
sleep 1
rm -rf "/Applications/CinePRO.app" 2>/dev/null || true

# 4. Limpa o cache do CEP do painel (Chromium cacheia JS antigo entre versões)
cinepro_limpar_cache "$USER_HOME"

exit 0
